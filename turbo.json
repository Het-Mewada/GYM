{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "ADMIN_DATABASE_URL",
    "JWT_SECRET",
    "JWT_ROTATION_SECRET",
    "COOKIE_SECRET",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^test", "^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "ADMIN_DATABASE_URL",
        "JWT_SECRET",
        "JWT_ROTATION_SECRET",
        "COOKIE_SECRET",
        "NODE_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
